# ── Base de datos ────────────────────────────────────────────────
POSTGRES_USER=agro
POSTGRES_PASSWORD=agro_dev_pass
POSTGRES_DB=agro_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL que usa el backend (dentro de la red de compose el host es "db")
DATABASE_URL=postgresql+psycopg://agro:agro_dev_pass@db:5432/agro_hub

# ── Backend / Auth ───────────────────────────────────────────────
# Generá una clave propia con: openssl rand -hex 32
SECRET_KEY=change-me-in-prod-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development

# Contraseña por defecto de los usuarios de demo (todos comparten esta clave)
DEFAULT_USER_PASSWORD=agro1234

# ── Frontend ─────────────────────────────────────────────────────
# Vacío = mismo origen: Vite proxea /api al backend (sirve para compartir por
# ngrok/cloudflared con un solo túnel al 5174). Poné una URL absoluta sólo si
# necesitás apuntar el front a una API en otro host.
VITE_API_URL=

# Compartir el sitio por un túnel (ngrok/cloudflared): poné true SOLO mientras lo
# compartís; deja el dev server aceptando hosts externos. Default false (solo localhost).
EXPOSE_PUBLIC=false
